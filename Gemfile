# Nur für die optionale lokale Vorschau nötig – GitHub Pages baut die Seite
# serverseitig mit genau diesen Versionen, ganz ohne lokale Ruby-Installation.
#
#   gem install bundler
#   bundle install
#   bundle exec jekyll serve
#
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

gem "webrick", "~> 1.8"   # ab Ruby 3.0 nicht mehr in der Standardbibliothek

gem "tzinfo-data", platforms: [:mingw, :x64_mingw, :mswin, :jruby]
